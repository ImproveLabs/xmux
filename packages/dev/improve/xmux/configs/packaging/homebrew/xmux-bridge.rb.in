# Homebrew formula for the xmux bridge, rendered by the release workflow (VERSION, SHA256).
# Copy the rendered file from the release assets into a tap (ImproveLabs/homebrew-xmux).
class XmuxBridge < Formula
  desc "Serve cmux screens to xmux headsets"
  homepage "https://github.com/ImproveLabs/xmux"
  url "https://github.com/ImproveLabs/xmux/releases/download/v@VERSION@/xmux-bridge-macos-universal.tar.gz"
  sha256 "@SHA256@"
  license "MIT"

  depends_on :macos

  def install
    bin.install "xmux-bridge"
  end

  def caveats
    <<~EOS
      Start the bridge at login (it finds your cmux session's socket now):
        xmux-bridge service install
      Then pair a headset:
        xmux-bridge pair
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/xmux-bridge --version")
  end
end
